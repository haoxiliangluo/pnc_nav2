<?xml version="1.0"?>
<!-- LIO-SAM 漂移测试世界：12m x 8m 房间 + 立柱/箱子做几何特征
     用途：长距离闭环测试（test/lio_drift_test.py 跑矩形轨迹） -->
<sdf version="1.9">
  <world name="lio_room">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>20</max_contacts>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 四面墙（房间 12 x 8，中心在 (2,0)，方便矩形轨迹 4x3 循环） -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8.4 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8.4 1.2</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>8 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8.4 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8.4 1.2</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>2 -4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.4 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.4 0.2 1.2</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>2 4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.4 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.4 0.2 1.2</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 内部特征：4 根立柱 + 2 个箱子（给 LOAM 提供角点/平面） -->
    <model name="pillar_1">
      <static>true</static><pose>0 2.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.9 0.5 0.3 1</ambient><diffuse>0.9 0.5 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static><pose>4 -2.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.9 0.5 0.3 1</ambient><diffuse>0.9 0.5 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>true</static><pose>6 2.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.9 0.5 0.3 1</ambient><diffuse>0.9 0.5 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_4">
      <static>true</static><pose>2 -1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.9 0.5 0.3 1</ambient><diffuse>0.9 0.5 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_1">
      <static>true</static><pose>1.0 2.0 0.4 0 0 0.6</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.3 0.7 0.4 1</ambient><diffuse>0.3 0.7 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static><pose>5.5 -1.5 0.3 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 1.2 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 1.2 0.6</size></box></geometry>
          <material><ambient>0.3 0.7 0.4 1</ambient><diffuse>0.3 0.7 0.4 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
