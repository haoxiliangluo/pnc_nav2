<?xml version="1.0"?>
<sdf version="1.9">
  <world name="world_demo">
    <!-- slope_wide：坡面加宽（±1.5m）用于验证轮足跑偏是否几何边界导致 -->
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>20</max_contacts>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 15° 缓坡：从 x≈2 升到 x≈4.9，高约 0.78m（长 3.1m，绕 y 轴 -15°） -->
    <model name="ramp15">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.1 3.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.1 3.0 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.9 1</ambient><diffuse>0.2 0.6 0.9 1</diffuse></material>
        </visual>
      </link>
      <pose>3.45 0 0.19 0 -0.2618 0</pose>
    </model>

    <!-- 平台：顶部与缓坡同高（0.78m） -->
    <model name="platform">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 4.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 4.0 0.5</size></box></geometry>
          <material><ambient>0.9 0.8 0.3 1</ambient><diffuse>0.9 0.8 0.3 1</diffuse></material>
        </visual>
      </link>
      <pose>6.4 0 0.53 0 0 0</pose>
    </model>

    <!-- 12cm 台阶（超出 step_max=0.10，应被判为不可通行） -->
    <model name="step_obstacle">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.12</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <pose>1.5 2.6 0.06 0 0 0</pose>
    </model>
  </world>
</sdf>
